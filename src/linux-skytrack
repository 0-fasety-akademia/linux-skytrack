#!/usr/bin/python3
"""Launcher for linux-skytrack (works from the source tree and when installed)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for base in (here, "/usr/share/linux-skytrack"):
    if os.path.isdir(os.path.join(base, "skytrack")):
        sys.path.insert(0, base)
        break

from skytrack.app import main  # noqa: E402

sys.exit(main())
